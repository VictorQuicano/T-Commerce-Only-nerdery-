extend type Query {
    me: User
    user(id: ID, email: String): User
    users(
        filter: UserFilterInput
        pagination: PaginationInput!
    ): UsersConnection!
}

input UserFilterInput {
    firstName: String
    middleName: String
    lastName: String
    roleId: Int
}

type UsersEdge{
    node: User!
    cursor: String!
}
type UsersConnection {
    edges: [UsersEdge]!
    pageInfo: PageInfo!
}